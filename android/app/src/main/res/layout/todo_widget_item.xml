<?xml version="1.0" encoding="utf-8"?>
<!-- ✅ PREMIUM TODO WIDGET ITEM - Matches in-app TodoCard design -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/todo_item_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/todo_card_default"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp">

        <!-- Row 1: Checkbox + Task + Category Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Circular Checkbox (matches Flutter circle checkbox) -->
            <ImageView
                android:id="@+id/todo_item_check"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_circle_unchecked"
                android:clickable="true"
                android:focusable="false"
                android:layout_marginEnd="12dp"
                android:scaleType="fitCenter"
                android:contentDescription="Toggle" />

            <!-- Task Text -->
            <TextView
                android:id="@+id/todo_item_task"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Task Name"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.2" />

            <!-- Category Pill Badge -->
            <TextView
                android:id="@+id/todo_item_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Personal"
                android:textSize="10sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.03"
                android:maxLines="1"
                android:ellipsize="end"
                android:maxWidth="80dp"
                android:layout_marginStart="8dp"
                android:visibility="visible" />

        </LinearLayout>

        <!-- Row 2: Due Date + Reminder Icon (below task, indented to align with text) -->
        <LinearLayout
            android:id="@+id/todo_item_due_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="6dp"
            android:paddingStart="38dp"
            android:visibility="gone">

            <!-- Calendar Icon -->
            <ImageView
                android:id="@+id/todo_item_calendar_icon"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/ic_calendar_small"
                android:layout_marginEnd="5dp"
                android:contentDescription="Due date" />

            <!-- Due Date Text -->
            <TextView
                android:id="@+id/todo_item_due_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Oct 29 • 10:00 AM"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.01"
                android:maxLines="1" />

            <!-- Reminder Bell Icon -->
            <ImageView
                android:id="@+id/todo_item_reminder"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginStart="10dp"
                android:src="@drawable/ic_bell_small"
                android:visibility="gone"
                android:contentDescription="Reminder set" />

            <!-- Repeat Icon -->
            <ImageView
                android:id="@+id/todo_item_repeat_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="10dp"
                android:src="@drawable/ic_repeat_small"
                android:layout_marginEnd="4dp"
                android:visibility="gone"
                android:contentDescription="Repeats" />

            <!-- Repeat Text -->
            <TextView
                android:id="@+id/todo_item_repeat_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="sans-serif-medium"
                android:visibility="gone"
                android:maxLines="1" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
